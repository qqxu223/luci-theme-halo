#!/usr/bin/ucode
'use strict';

/*
 * luci.halo — per-host traffic counters for the Halo dashboard.
 *
 * WHY THIS EXISTS
 * ---------------
 * The stock `luci/getConntrackList` serialises the whole nf_conntrack table
 * into one blobmsg reply. On a router with a few thousand entries that reply
 * is several megabytes, the call takes tens of seconds, and rpcd — which is
 * single threaded and holds every LuCI session — falls over. That is how the
 * dashboard used to log everybody out.
 *
 * The browser does not need the table. It needs "bytes per LAN host", so the
 * aggregation happens here and only the totals cross the bus: a few hundred
 * bytes, no matter how big the table is.
 *
 * COST MODEL (measured on a 4 MB, ~13k entry table, aarch64 router)
 * ---------------------------------------------------------------
 * Each read() of /proc/net/nf_conntrack walks the whole table — the file does
 * not support lseek, so a 64 kB buffer means 60 walks and eight seconds.
 * Hence: ONE big buffer, and a hard cap on the number of reads.
 *
 *   read(BUF)      4 MiB  → typical 3-4 MiB table in ONE walk (~1 s here)
 *   MAX_PASSES     2      → 8 MiB covered, then we stop and say so
 *   MAX_HOSTS      96     → bounded reply size
 *
 * If the cap is hit, `truncated` is set and the caller must ignore the sample
 * (counters would be partial and every delta would be junk).
 *
 * Counters are CUMULATIVE per connection. The caller keeps the previous sample
 * and divides the difference by elapsed time to get bytes/s.
 */

const fs = require('fs');

const PATH = '/proc/net/nf_conntrack';
const BUF = 4194304;
const MAX_PASSES = 2;
const MAX_HOSTS = 96;
const TTL = 8;                /* seconds a sample is reused for */

/* rpcd loads this plugin once, so module state lives as long as the process.
 * Several tabs polling at once would otherwise mean several full table walks
 * per cycle; with a TTL they collapse into one. rpcd is single threaded, so
 * there is nothing to lock. */
let cache = null;

/* "1.2.3.4 dst=..." -> "1.2.3.4" */
function head(s) {
	let i = index(s, ' ');
	return i < 0 ? s : substr(s, 0, i);
}

/* "60 [UNREPLIED] ..." -> 60  (leading decimal digits only) */
function digits(s) {
	let i = 0;
	let n = length(s);
	while (i < n) {
		let c = substr(s, i, 1);
		if (c < '0' || c > '9')
			break;
		i++;
	}
	return i ? +substr(s, 0, i) : 0;
}

/*
 * One conntrack line holds two tuples:
 *   ... src=A dst=B ... bytes=N  [STATE]  src=C dst=D ... bytes=M
 * N is what the original direction moved, M the reply direction. Whichever
 * tuple starts inside the LAN is the host we account for.
 */
function scan(rows, st, lan) {
	for (let line in rows) {
		if (length(line) < 40)
			continue;

		st.lines++;

		if (index(line, lan) < 0)
			continue;

		let srcs = split(line, 'src=');
		let byts = split(line, 'bytes=');
		if (length(srcs) < 3 || length(byts) < 3)
			continue;

		st.hits++;

		let s1 = head(srcs[1]);
		let s2 = head(srcs[2]);
		let b1 = digits(byts[1]);
		let b2 = digits(byts[2]);
		let ip, up, down;

		if (substr(s1, 0, length(lan)) == lan) {
			ip = s1;
			up = b1;
			down = b2;
		}
		else if (substr(s2, 0, length(lan)) == lan) {
			ip = s2;
			up = b2;
			down = b1;
		}
		else
			continue;

		let h = st.hosts[ip];
		if (h == null)
			h = st.hosts[ip] = { up: 0, down: 0 };

		h.up += up;
		h.down += down;
	}
}

return {
	'luci.halo': {
		talkers: {
			args: { lan: '' },
			call: function (req) {
				let lan = (req && req.args && type(req.args.lan) == 'string') ? req.args.lan : '';

				/* NB: this ucode build rejects `throw` at statement level, and
				 * rpcd treats a null reply as "no data" — which is exactly the
				 * degradation the caller wants, so failures return null. */
				if (!length(lan))
					return null;

				if (cache != null && cache.lan == lan && time() - cache.at < TTL)
					return cache.data;

				let fh = fs.open(PATH, 'r');
				if (!fh)
					return null;

				let st = { hosts: {}, lines: 0, hits: 0 };
				let carry = '';
				let passes = 0;
				let complete = false;
				let chunk;

				while (passes < MAX_PASSES) {
					chunk = fh.read(BUF);
					if (chunk == null)
						break;

					let got = length(chunk);
					if (!got)
						break;

					passes++;

					let rows = split(carry + chunk, '\n');
					chunk = null;
					carry = pop(rows);
					scan(rows, st, lan);

					/* short read on a non-seekable seq_file means end of table */
					if (got < BUF) {
						complete = true;
						break;
					}
				}

				fh.close();

				if (length(carry))
					scan([carry], st, lan);

				let list = [];
				let up = 0;
				let down = 0;

				for (let ip in st.hosts) {
					push(list, { ip: ip, up: st.hosts[ip].up, down: st.hosts[ip].down });
					up += st.hosts[ip].up;
					down += st.hosts[ip].down;
				}

				sort(list, function (a, b) {
					return (b.up + b.down) - (a.up + a.down);
				});

				if (length(list) > MAX_HOSTS)
					list = slice(list, 0, MAX_HOSTS);

				let data = {
					t: time(),
					lan: lan,
					passes: passes,
					lines: st.lines,
					truncated: !complete,
					up: up,
					down: down,
					hosts: list
				};

				/* a truncated sample is still worth caching: it keeps a caller on
				 * a huge table from re-walking the table on every request */
				cache = { at: data.t, lan: lan, data: data };

				return data;
			}
		}
	}
};
