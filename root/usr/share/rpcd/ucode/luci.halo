#!/usr/bin/ucode
'use strict';

/*
 * luci.halo — per-host traffic rates for the Halo dashboard.
 *
 * WHY THIS EXISTS
 * ---------------
 * The stock `luci/getConntrackList` serialises the whole nf_conntrack table
 * into one blobmsg reply. On a router with a few thousand entries that reply
 * is several megabytes, the call takes tens of seconds, and rpcd — which is
 * single threaded and holds every LuCI session — falls over. That is how the
 * dashboard used to log everybody out.
 *
 * The browser does not need the table. It needs "how much did each LAN host
 * move since the last look", so the diffing happens here and only the result
 * crosses the bus: a few hundred bytes, whatever the table size.
 *
 * WHY PER-CONNECTION DIFFS AND NOT PER-HOST TOTALS
 * -----------------------------------------------
 * Summing `bytes=` per host looks like a counter and is not one: the moment a
 * connection closes, its bytes leave the sum. Measured here, the sum dropped
 * by hundreds of kB/s while the link carried a few kB/s — so rates built from
 * it read as zero exactly when the box is busy, which is the one time the card
 * matters.
 *
 * Each connection is therefore keyed by its endpoints and diffed against the
 * previous sample; only the growth of connections seen in both samples counts.
 * A closed connection contributes nothing instead of a negative. A connection
 * opened inside the window contributes its growth from zero, which is real.
 *
 * COST MODEL (measured here: aarch64, 4 MB / 13k entry table)
 * ---------------------------------------------------------
 * /proc/net/nf_conntrack has no lseek, so *every* read() walks the whole
 * table: a 64 kB buffer meant 49 walks and 8.4 s. Hence one big buffer and a
 * hard cap on the number of reads.
 *
 *   read(BUF)      4 MiB  → the whole table in ONE walk (~0.9 s per MiB)
 *   MAX_PASSES     2      → 8 MiB covered, then stop and say `truncated`
 *   MAX_HOSTS      96     → bounded reply size
 *   TTL            8 s    → several tabs collapse into one walk
 *
 * The caller is expected to sample every 12 s or slower and to ignore any
 * reply with `truncated: true` (partial counters diff into garbage).
 */

const fs = require('fs');

const PATH = '/proc/net/nf_conntrack';
const BUF = 4194304;
const MAX_PASSES = 2;
const MAX_HOSTS = 96;
const TTL = 8;

/* rpcd loads this plugin once, so module state lives as long as the process.
 * rpcd is single threaded: no locking needed. */
let prev = null;        /* key -> [bytes original direction, bytes reply] */
let prevAt = null;      /* monotonic clock at that sample */
let cache = null;       /* { at, lan, data } */

/* "1.2.3.4 dst=..." -> "1.2.3.4" */
function head(s) {
	let i = index(s, ' ');
	return i < 0 ? s : substr(s, 0, i);
}

/* "60 [UNREPLIED] ..." -> 60  (leading decimal digits only) */
function digits(s) {
	let i = 0;
	let n = length(s);
	while (i < n) {
		let c = substr(s, i, 1);
		if (c < '0' || c > '9')
			break;
		i++;
	}
	return i ? +substr(s, 0, i) : 0;
}

function mono() {
	let c = clock(true);
	/* the divisor must be a float: ucode does integer division on ints, and the
	 * nanosecond component would be dropped (cost then reads in whole seconds) */
	return c[0] + c[1] / 1000000000.0;
}

/*
 * One conntrack line holds two tuples:
 *   ipv4 2 tcp 6 431999 ESTABLISHED src=A dst=B sport=1 dport=2 ... bytes=N
 *                                       src=C dst=D sport=2 dport=1 ... bytes=M
 * N is what the original direction moved, M the reply direction. Whichever
 * tuple starts inside the LAN is the host being accounted for.
 */
function scan(rows, st, lan) {
	for (let line in rows) {
		if (length(line) < 40)
			continue;

		st.lines++;

		if (index(line, lan) < 0)
			continue;

		let srcs = split(line, 'src=');
		let byts = split(line, 'bytes=');
		if (length(srcs) < 3 || length(byts) < 3)
			continue;

		st.hits++;

		let s1 = head(srcs[1]);
		let s2 = head(srcs[2]);
		let b1 = digits(byts[1]);
		let b2 = digits(byts[2]);
		let ip, hostIsFirst;

		if (substr(s1, 0, length(lan)) == lan) {
			ip = s1;
			hostIsFirst = true;
		}
		else if (substr(s2, 0, length(lan)) == lan) {
			ip = s2;
			hostIsFirst = false;
		}
		else
			continue;

		/* connection identity — built only for lines that touch the LAN, which
		 * is a small fraction of the table */
		let toks = split(line, ' ');
		let proto = (length(toks) > 2) ? toks[2] : 'x';
		let key = s1 + '>' + s2 + '/' + proto;
		let gotS = false;
		let gotD = false;

		for (let t in toks) {
			if (!gotS && substr(t, 0, 6) == 'sport=') {
				key += ':' + substr(t, 6);
				gotS = true;
			}
			else if (!gotD && substr(t, 0, 6) == 'dport=') {
				key += '-' + substr(t, 6);
				gotD = true;
			}
		}

		st.cur[key] = [b1, b2];

		if (prev == null)
			continue;

		let o = prev[key];
		if (o == null)
			continue;

		let d1 = b1 - o[0];
		let d2 = b2 - o[1];
		if (d1 <= 0 && d2 <= 0)
			continue;

		let h = st.hosts[ip];
		if (h == null)
			h = st.hosts[ip] = { up: 0, down: 0 };

		if (hostIsFirst) {
			if (d1 > 0) h.up += d1;
			if (d2 > 0) h.down += d2;
		}
		else {
			if (d1 > 0) h.down += d1;
			if (d2 > 0) h.up += d2;
		}
	}
}

return {
	'luci.halo': {
		talkers: {
			args: { lan: '' },
			call: function (req) {
				let lan = (req && req.args && type(req.args.lan) == 'string') ? req.args.lan : '';

				/* NB: this ucode build rejects `throw` at statement level, and
				 * rpcd treats a null reply as "no data" — exactly the
				 * degradation the caller wants, so failures return null. */
				if (!length(lan))
					return null;

				let now = mono();

				if (cache != null && cache.lan == lan && now - cache.at < TTL)
					return cache.data;

				let started = now;

				let fh = fs.open(PATH, 'r');
				if (!fh)
					return null;

				let st = { hosts: {}, cur: {}, lines: 0, hits: 0 };
				let carry = '';
				let passes = 0;
				let complete = false;
				let chunk;

				while (passes < MAX_PASSES) {
					chunk = fh.read(BUF);
					if (chunk == null)
						break;

					let got = length(chunk);
					if (!got)
						break;

					passes++;

					let rows = split(carry + chunk, '\n');
					chunk = null;
					carry = pop(rows);
					scan(rows, st, lan);

					/* a short read on a non-seekable seq_file is end of table */
					if (got < BUF) {
						complete = true;
						break;
					}
				}

				fh.close();

				if (length(carry))
					scan([carry], st, lan);

				let dt = 0;
				if (prevAt != null)
					dt = now - prevAt;

				/* A truncated scan is not a usable baseline: some connections
				 * were never seen, so the next diff would report their whole
				 * history. Keep the old baseline; the caller skips this reply. */
				if (complete) {
					prev = st.cur;
					prevAt = now;
				}

				let list = [];
				let up = 0;
				let down = 0;

				for (let ip in st.hosts) {
					let h = st.hosts[ip];
					up += h.up;
					down += h.down;
					push(list, { ip: ip, up: h.up, down: h.down });
				}

				sort(list, function (a, b) {
					return (b.up + b.down) - (a.up + a.down);
				});

				if (length(list) > MAX_HOSTS)
					list = slice(list, 0, MAX_HOSTS);

				let data = {
					t: time(),
					/* own cost, so the caller can back off on real work instead
					 * of on rpcd queueing time */
					ms: 0,
					/* no Math.* in this ucode build — the raw float is fine */
					dt: (dt > 0 && dt < 600) ? dt : 0,
					lan: lan,
					passes: passes,
					lines: st.lines,
					truncated: !complete,
					up: up,
					down: down,
					hosts: list
				};

				let ended = mono();
				data.ms = (ended > started) ? (ended - started) * 1000 : 0;
				cache = { at: now, lan: lan, data: data };

				return data;
			}
		}
	}
};
