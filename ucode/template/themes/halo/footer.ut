{% if (!blank_page): %}
			</div> {# /#maincontent #}

			<footer class="halo-foot">
				<span>
					<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }}</a>
					· {{ version.luciname }} {{ version.luciversion }}
					{% if (lua_active): %} · {{ _('Lua compatibility mode active') }}{% endif %}
				</span>
				<ul id="modemenu"></ul>
			</footer>
		</div> {# /#halo-main #}
	</div> {# /#halo-shell #}

	<div class="halo-cmdk" id="halo-cmdk" hidden>
		<div class="halo-cmdk-box" role="dialog" aria-modal="true" aria-label="{{ _('Search') }}">
			<div class="halo-cmdk-head">
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="7" cy="7" r="4.6"/><path d="M10.6 10.6L13.6 13.6"/></svg>
				<input id="halo-cmdk-input" type="text" autocomplete="off" spellcheck="false" placeholder="输入以筛选页面">
				<span class="halo-kbd">esc</span>
			</div>
			<div class="halo-cmdk-list" id="halo-cmdk-list"></div>
		</div>
	</div>

	<script>L.require('menu-halo')</script>
{% else %}
		</main>
	</div>
{% endif %}
</body>
</html>
